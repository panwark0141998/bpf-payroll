# BPF Payroll - Environment Configuration

# Server
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000

# Desktop & Mobile Client URLs (CORS)
CLIENT_URL=http://localhost:3000
MOBILE_URL=http://localhost:3001

# PostgreSQL Database Configuration
# Direct Supabase Session Pooler (port 5432):
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
# Supabase Transaction Pooler (port 6543):
# DATABASE_TRANSACTION_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=
PGLITE_DATA_DIR=./data/pglite_db

# Supabase API & Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_key

# Security & Tokens
JWT_SECRET=bpf_super_secret_jwt_access_token_key_2026_x89f
JWT_REFRESH_SECRET=bpf_super_secret_jwt_refresh_token_key_2026_z12m
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=bpf_cookie_secure_signer_9921_secret

# Biometric & Face Verification
FACE_VERIFICATION_THRESHOLD=0.82
FACE_LIVENESS_ENABLED=true
FACE_MAX_RETRY=3
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Company Default Locale & Timezone
COMPANY_DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR

# Geofence Defaults
DEFAULT_GEOFENCE_RADIUS_METERS=100

# File Storage
STORAGE_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Email SMTP (Optional in dev)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=payroll@bpftechnologies.com
