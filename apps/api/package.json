{
  "name": "@bpf/api",
  "version": "1.0.0",
  "description": "Central Backend REST API for BPF Payroll",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "tsx src/database/migrate.ts",
